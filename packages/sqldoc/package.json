{
  "type": "module",
  "name": "@sqldoc/sqldoc",
  "version": "0.2.5",
  "description": "Global CLI shim for sqldoc -- finds .sqldoc/ and delegates to project-local @sqldoc/cli",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "sqldoc": "./bin/sqldoc"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsgo -noEmit",
    "build:types": "tsgo -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@npmcli/arborist": "^9.4.2",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@sqldoc/test-utils": "workspace:*",
    "@types/npmcli__arborist": "^6.3.3",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
