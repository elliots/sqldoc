{
  "type": "module",
  "name": "@sqldoc/sqldoc",
  "version": "0.0.2",
  "description": "Global CLI shim for sqldoc -- finds .sqldoc/ and delegates to project-local @sqldoc/cli",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "sqldoc": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@sqldoc/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
