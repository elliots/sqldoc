{
  "type": "module",
  "name": "@sqldoc/sqldoc",
  "version": "0.2.3",
  "description": "Global CLI shim for sqldoc -- finds .sqldoc/ and delegates to project-local @sqldoc/cli",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "sqldoc": "./bin/sqldoc"
  },
  "files": [
    "bin",
    "src",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsgo -noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@npmcli/arborist": "^9.4.2",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@sqldoc/test-utils": "workspace:*",
    "@types/npmcli__arborist": "^6.3.3",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
