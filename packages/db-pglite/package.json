{
  "type": "module",
  "name": "@sqldoc/db-pglite",
  "version": "0.2.10",
  "description": "PGlite embedded PostgreSQL adapter for sqldoc (zero-config, in-memory)",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "package.json"
  ],
  "dependencies": {
    "@electric-sql/pglite": "^0.4.0"
  },
  "devDependencies": {
    "@sqldoc/db": "workspace:*",
    "@sqldoc/test-utils": "workspace:*",
    "typescript": "catalog:"
  },
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsc -noEmit",
    "build:types": "tsc -p tsconfig.build.json"
  }
}
