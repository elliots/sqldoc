{
  "type": "module",
  "name": "@sqldoc/db-neon-temporary",
  "version": "0.2.8",
  "description": "Neon ephemeral database adapter for sqldoc (creates temporary databases via neon-new)",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "package.json"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "@sqldoc/db": "workspace:*",
    "@sqldoc/test-utils": "workspace:*",
    "@typescript/native-preview": "catalog:"
  },
  "scripts": {
    "build:types": "tsgo -p tsconfig.build.json"
  }
}
