{
  "type": "module",
  "name": "@sqldoc/ns-lint",
  "version": "0.2.10",
  "description": "Lint namespace for sqldoc -- @lint.ignore tag for suppressing lint rules",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsc -noEmit",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@sqldoc/core": "workspace:*"
  },
  "devDependencies": {
    "@sqldoc/core": "workspace:*",
    "typescript": "catalog:",
    "@sqldoc/test-utils": "workspace:*"
  }
}
