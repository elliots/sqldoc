{
  "type": "module",
  "name": "@sqldoc/cli",
  "version": "0.2.10",
  "sqldoc": {
    "minShimVersion": "0.0.10"
  },
  "description": "CLI tool for sqldoc -- compile and validate SQL files with tag-driven generation",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "sqldoc": "src/main.ts"
  },
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsc -noEmit",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sqldoc/core": "workspace:*",
    "@sqldoc/db": "workspace:*",
    "@sqltools/formatter": "1.2.5",
    "commander": "14.0.3",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@sqldoc/test-utils": "workspace:*",
    "typescript": "catalog:"
  }
}
