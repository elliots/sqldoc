{
  "type": "module",
  "name": "@sqldoc/db",
  "version": "0.2.2",
  "description": "Database adapters and schema type re-exports for sqldoc",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsgo -noEmit"
  },
  "dependencies": {
    "@sqldoc/core": "workspace:*",
    "@sqldoc/inspector": "workspace:*",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@sqldoc/db-pglite": "workspace:*",
    "@sqldoc/db-postgres": "workspace:*",
    "@sqldoc/db-mysql": "workspace:*",
    "@sqldoc/test-utils": "workspace:*",
    "@typescript/native-preview": "catalog:"
  }
}
