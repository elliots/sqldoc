{
  "type": "module",
  "name": "@sqldoc/db",
  "version": "0.2.9",
  "description": "Database adapters and schema type re-exports for sqldoc",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsgo -noEmit",
    "build:types": "tsgo -p tsconfig.build.json"
  },
  "dependencies": {
    "@sqldoc/core": "workspace:*",
    "@sqldoc/inspector": "workspace:*",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@sqldoc/db-pglite": "workspace:*",
    "@sqldoc/db-postgres": "workspace:*",
    "@sqldoc/db-mysql": "workspace:*",
    "@sqldoc/test-utils": "workspace:*",
    "@typescript/native-preview": "catalog:"
  }
}
