{
  "type": "module",
  "name": "@sqldoc/ns-anon",
  "version": "0.1.1",
  "description": "PostgreSQL Anonymizer namespace for sqldoc -- generates SECURITY LABEL statements",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsgo -noEmit"
  },
  "peerDependencies": {
    "@sqldoc/core": "workspace:*"
  },
  "devDependencies": {
    "@sqldoc/core": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "@sqldoc/test-utils": "workspace:*"
  }
}
