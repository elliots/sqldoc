{
  "type": "module",
  "name": "@sqldoc/core",
  "version": "0.0.8",
  "description": "Core engine for sqldoc -- parser, loader, validator, types",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test": {
      "types": "./src/test.ts",
      "import": "./src/test.ts",
      "default": "./src/test.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "lint": "biome check src/",
    "typecheck": "tsgo -noEmit"
  },
  "dependencies": {
    "@sqldoc/sqlparser-ts": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@typescript/native-preview": "catalog:",
    "@sqldoc/test-utils": "workspace:*"
  }
}
