{
  "type": "module",
  "name": "@sqldoc/core",
  "version": "0.2.7",
  "description": "Core engine for sqldoc -- parser, loader, validator, types",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./test": {
      "types": "./dist/types/test.d.ts",
      "import": {
        "types": "./dist/types/test.d.ts",
        "import": "./src/test.ts",
        "default": "./src/test.ts"
      },
      "default": {
        "types": "./dist/types/test.d.ts",
        "import": "./src/test.ts",
        "default": "./src/test.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "lint": "biome check src/",
    "typecheck": "tsgo -noEmit",
    "build:types": "tsgo -p tsconfig.build.json"
  },
  "dependencies": {
    "@sqldoc/sqlparser-ts": "0.61.3",
    "pgsql-parser": "17.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@typescript/native-preview": "catalog:",
    "@sqldoc/test-utils": "workspace:*"
  }
}
