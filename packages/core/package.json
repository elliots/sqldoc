{
  "type": "module",
  "name": "@sqldoc/core",
  "version": "0.0.2",
  "description": "Core engine for sqldoc -- parser, loader, validator, types",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sqldoc/sqlparser-ts": "workspace:*",
    "bundle-require": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
