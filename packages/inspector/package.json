{
  "type": "module",
  "name": "@sqldoc/inspector",
  "version": "0.2.6",
  "description": "TypeScript port of Atlas schema inspector for sqldoc",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "NOTICE",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsgo -noEmit",
    "build:types": "tsgo -p tsconfig.build.json"
  },
  "dependencies": {
    "@sqldoc/core": "workspace:*"
  },
  "devDependencies": {
    "@sqldoc/db": "workspace:*",
    "@sqldoc/db-mssql": "workspace:*",
    "@sqldoc/db-pglite": "workspace:*",
    "@typescript/native-preview": "catalog:"
  }
}
