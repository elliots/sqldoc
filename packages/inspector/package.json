{
  "type": "module",
  "name": "@sqldoc/inspector",
  "version": "0.2.9",
  "description": "TypeScript port of Atlas schema inspector for sqldoc",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "NOTICE",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsc -noEmit",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sqldoc/core": "workspace:*"
  },
  "devDependencies": {
    "@sqldoc/db": "workspace:*",
    "@sqldoc/db-mssql": "workspace:*",
    "@sqldoc/db-pglite": "workspace:*",
    "@sqldoc/test-utils": "workspace:*",
    "typescript": "catalog:"
  }
}
