{
  "type": "module",
  "name": "@sqldoc/ns-history",
  "version": "0.2.6",
  "description": "History namespace for sqldoc -- generates history tables and triggers for change tracking",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "package.json"
  ],
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsgo -noEmit",
    "build:types": "tsgo -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@sqldoc/core": "workspace:*"
  },
  "devDependencies": {
    "@sqldoc/core": "workspace:*",
    "@sqldoc/db": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "@sqldoc/test-utils": "workspace:*"
  }
}
