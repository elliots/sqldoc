{
  "type": "module",
  "name": "@sqldoc/db-neon",
  "version": "0.2.9",
  "description": "Neon serverless PostgreSQL adapter for sqldoc (drift detection against live Neon databases)",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "files": [
    "src",
    "dist",
    "package.json"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0"
  },
  "devDependencies": {
    "@sqldoc/db": "workspace:*",
    "@sqldoc/test-utils": "workspace:*",
    "@typescript/native-preview": "catalog:"
  },
  "scripts": {
    "test": "node --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsgo -noEmit",
    "build:types": "tsgo -p tsconfig.build.json"
  }
}
