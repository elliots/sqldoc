{
  "name": "sqldoc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd vscode-sqldoc && node build.mjs && cd .. && bash scripts/build-binary.sh",
    "build:types": "bun run --filter '*' build:types",
    "clean:types": "find packages -maxdepth 3 -type d -name dist -prune -exec rm -rf {} +",
    "install-vscode-extension": "cd vscode-sqldoc && bun run install-ext",
    "test": "SQLDOC_RESOLVE_FROM_LOCAL_PACKAGE=true NODE_NO_WARNINGS=1 node --test 'packages/**/*.test.ts' 'vscode-sqldoc/src/**/*.test.ts' 'tests/**/*.test.ts'",
    "test:bun": "SQLDOC_RESOLVE_FROM_LOCAL_PACKAGE=true NODE_NO_WARNINGS=1 sh -c \"find packages vscode-sqldoc/src tests -name '*.test.ts' ! -path 'packages/db-postgres/src/__tests__/adapter.integration.test.ts' -print | xargs bun test --parallel --timeout ${TEST_TIMEOUT:-1200000}\"",
    "test:coverage": "SQLDOC_RESOLVE_FROM_LOCAL_PACKAGE=true NODE_NO_WARNINGS=1 node --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='tests/**' --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='**/dist/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test 'packages/**/*.test.ts' 'vscode-sqldoc/src/**/*.test.ts' 'tests/**/*.test.ts'",
    "test-docs": "./scripts/test-docs.sh",
    "format": "biome format --write .",
    "check:fast": "biome check --fix . && bun run --filter '*' typecheck",
    "check:templates": "./tests/pet-store-postgres/generate-all-templates.sh",
    "check": "bun run check:fast && bun run check:templates",
    "check:fix": "biome check --fix --unsafe . && bun run check",
    "check:licenses": "bun pm ls --production 2>&1 | node -e \"const d=require('fs').readFileSync('/dev/stdin','utf8');const bad=d.match(/GPL|AGPL|EUPL|SSPL|BSL-1|CPAL|OSL-3/gi);if(bad){console.error('Copyleft licenses found:',bad);process.exit(1)}else console.log('All licenses OK')\"",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +"
  },
  "catalog": {
    "typescript": "7.0.1-rc",
    "@types/node": "24",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/node": "24",
    "esbuild": "0.27.4",
    "fossilize": "0.5.0",
    "lefthook": "2.1.4"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign",
    "better-sqlite3",
    "esbuild",
    "lefthook"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "vscode-sqldoc",
    "tests"
  ],
  "version": "0.2.10"
}
