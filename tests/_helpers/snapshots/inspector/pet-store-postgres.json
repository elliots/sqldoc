          ],
          "body": "CREATE OR REPLACE FUNCTION public.get_adoption_report(p_owner_id integer DEFAULT NULL::integer)\n RETURNS SETOF public.adoption_report\n LANGUAGE sql\n STABLE\nAS $function$\n  SELECT p.name, o.name, a.adopted_at, a.adoption_fee, c.name\n  FROM adoptions a\n  JOIN pets p ON p.id = a.pet_id\n  JOIN owners o ON o.id = a.owner_id\n  LEFT JOIN categories c ON c.id = p.category_id\n  WHERE p_owner_id IS NULL OR o.id = p_owner_id;\n$function$\n",
          "deps": [
            {
              "name": "adoption_report",
              "type": "compositeType"
            },
            {
              "name": "adoptions",
              "schema": "public",
              "type": "table"
            },
            {
              "name": "categories",
              "schema": "public",
              "type": "table"
            },
