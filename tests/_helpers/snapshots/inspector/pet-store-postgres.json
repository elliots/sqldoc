              "name": "owners",
              "schema": "public",
              "type": "table"
            },
            {
              "name": "pets",
              "schema": "public",
              "type": "table"
            }
          ],
          "lang": "sql",
          "name": "get_adoption_report",
          "ret": {
            "raw": "SETOF adoption_report",
            "type": {
              "T": "SETOF adoption_report",
              "kind": "unknown"
            }
          },
